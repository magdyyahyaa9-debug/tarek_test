<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_smart_approval_type_list" model="ir.ui.view">
        <field name="name">smart.approval.type.list</field>
        <field name="model">smart.approval.type</field>
        <field name="arch" type="xml"><list>
            <field name="name"/><field name="code"/><field name="min_amount"/>
            <field name="max_amount"/><field name="currency_id"/><field name="active"/>
        </list></field>
    </record>
    <record id="view_smart_approval_type_form" model="ir.ui.view">
        <field name="name">smart.approval.type.form</field>
        <field name="model">smart.approval.type</field>
        <field name="arch" type="xml">
            <form string="Approval Type"><sheet>
                <group><group><field name="name"/><field name="code"/><field name="active"/></group>
                <group><field name="currency_id"/><field name="amount_required"/>
                    <field name="min_amount"/><field name="max_amount"/></group></group>
                <field name="description"/>
                <notebook><page string="Approval Stages"><field name="step_ids">
                    <list editable="bottom"><field name="sequence" widget="handle"/>
                        <field name="name"/><field name="user_id"/></list>
                </field></page></notebook>
            </sheet></form>
        </field>
    </record>
    <record id="action_smart_approval_types" model="ir.actions.act_window">
        <field name="name">Approval Types</field><field name="res_model">smart.approval.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
