<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_smart_approval" model="ir.module.category">
        <field name="name">Smart Approvals</field>
    </record>
    <record id="privilege_smart_approval" model="res.groups.privilege">
        <field name="name">Smart Approvals</field>
        <field name="category_id" ref="module_category_smart_approval"/>
    </record>
    <record id="group_smart_approval_user" model="res.groups">
        <field name="name">Approval User</field>
        <field name="privilege_id" ref="privilege_smart_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_smart_approval_manager" model="res.groups">
        <field name="name">Approval Manager</field>
        <field name="privilege_id" ref="privilege_smart_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_smart_approval_user'))]"/>
    </record>
    <record id="rule_approval_request_user" model="ir.rule">
        <field name="name">Own requests or assigned approvals</field>
        <field name="model_id" ref="model_smart_approval_request"/>
        <field name="groups" eval="[(4, ref('group_smart_approval_user'))]"/>
        <field name="domain_force">['|', ('requester_id', '=', user.id), ('approval_line_ids.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_approval_line_user" model="ir.rule">
        <field name="name">Decisions for visible requests</field>
        <field name="model_id" ref="model_smart_approval_line"/>
        <field name="groups" eval="[(4, ref('group_smart_approval_user'))]"/>
        <field name="domain_force">['|', ('request_id.requester_id', '=', user.id), ('request_id.approval_line_ids.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_approval_request_manager" model="ir.rule">
        <field name="name">Managers see all approval requests</field>
        <field name="model_id" ref="model_smart_approval_request"/>
        <field name="groups" eval="[(4, ref('group_smart_approval_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_approval_line_manager" model="ir.rule">
        <field name="name">Managers see all decisions</field>
        <field name="model_id" ref="model_smart_approval_line"/>
        <field name="groups" eval="[(4, ref('group_smart_approval_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
